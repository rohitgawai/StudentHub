{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-explicit-any", "no-unused-vars", "prefer-const"]
    }
  },
  "fmt": {
    "options": {
      "indentWidth": 2,
      "lineWidth": 100,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "imports": {
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2.45.0",
    "bcryptjs": "npm:bcryptjs@2.4.3"
  }
}